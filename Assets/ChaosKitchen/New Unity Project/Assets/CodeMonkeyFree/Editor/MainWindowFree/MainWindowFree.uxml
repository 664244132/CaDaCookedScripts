<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/ChaosKitchen/New Unity Project/Assets/CodeMonkeyFree/Editor/MainWindowFree/MainWindowFree.uss?fileID=7433441132597879392&amp;guid=b33e7af7bb189244b8e28f2f531654fa&amp;type=3#MainWindowFree" />
    <ui:VisualElement name="main" class="main-container">
        <ui:VisualElement name="logo" class="logo-banner" />
        <ui:VisualElement name="mainMenu" class="main-menu-container">
            <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1" class="main-scroll-view">
                <ui:VisualElement name="checkingForUpdates" class="checking-updates-container">
                    <ui:Label tabindex="-1" text="Checking for Updates..." parse-escape-sequences="true" display-tooltip-when-elided="true" name="textLabel" class="checking-updates-label cursor-link" />
                </ui:VisualElement>
                <ui:VisualElement name="premiumVersion" class="premium-banner-container">
                    <ui:Label text="&lt;a href=&quot;https://cmonkey.co/kitchenchaospaidcourse&quot;&gt;If you find this FREE course helpful, (and you can afford it), get the Premium version, Click here!&lt;/a&gt;" parse-escape-sequences="true" class="premium-banner-label" />
                </ui:VisualElement>
                <ui:Button text="Lecture List" parse-escape-sequences="true" display-tooltip-when-elided="true" name="lectureListButton" class="lecture-list-toggle-button" />
                <ui:VisualElement name="staticMessage" class="static-message-container">
                    <ui:Label tabindex="-1" text="Hi there!&#10;Thanks for checking out my &lt;b&gt;FREE&lt;/b&gt; course, I hope it helps you a ton in your learning journey!&#10;Remember you can download the Project Files for every lecture in the course, great way to compare directly with your own in case you get stuck.&#10;Post any questions in the comments and I&apos;ll do my best to help.&#10;- Code Monkey" parse-escape-sequences="true" display-tooltip-when-elided="true" name="messageLabel" class="static-message-label" />
                </ui:VisualElement>
                <ui:VisualElement name="message" class="promo-message-container">
                    <ui:Label tabindex="-1" text="&lt;a href=&quot;https://cmonkey.co/tictactoenfefree&quot;&gt;I just published my latest FREE course! Click here!&lt;/a&gt;" parse-escape-sequences="true" display-tooltip-when-elided="true" name="messageLabel" class="promo-message-label" />
                </ui:VisualElement>
                <ui:VisualElement name="dynamicHeader" class="dynamic-header-card">
                    <ui:VisualElement name="image" class="dynamic-header-image" />
                    <ui:Label text="&lt;a href=&quot;https://cmonkey.co/freecourses&quot;&gt;Learn to make games with my complete FREE Courses!&lt;/a&gt;" name="text" parse-escape-sequences="true" class="dynamic-header-text" />
                </ui:VisualElement>
                <ui:VisualElement name="qotd" class="qotd-card">
                    <ui:Label tabindex="-1" text="QUESTION OF THE DAY" parse-escape-sequences="true" display-tooltip-when-elided="true" name="qotdTitle" class="qotd-title" />
                    <ui:Label tabindex="-1" text="How much time per frame do you have in order to hit 60FPS?" parse-escape-sequences="true" display-tooltip-when-elided="true" name="questionLabel" class="qotd-question-label" />
                    <ui:Button text="Answer" parse-escape-sequences="true" display-tooltip-when-elided="true" name="answerAButton" class="qotdAnswerButton" />
                    <ui:Button text="Answer" parse-escape-sequences="true" display-tooltip-when-elided="true" name="answerBButton" class="qotdAnswerButton" />
                    <ui:Button text="Answer" parse-escape-sequences="true" display-tooltip-when-elided="true" name="answerCButton" class="qotdAnswerButton" />
                    <ui:Button text="Answer" parse-escape-sequences="true" display-tooltip-when-elided="true" name="answerDButton" class="qotdAnswerButton" />
                    <ui:Button text="Answer" parse-escape-sequences="true" display-tooltip-when-elided="true" name="answerEButton" class="qotdAnswerButton" />
                </ui:VisualElement>
                <ui:VisualElement name="dynamicMessage" class="dynamic-message-container cursor-link">
                    <ui:Label tabindex="-1" text="&lt;u&gt;Get awesome assets 90% OFF!&lt;/u&gt;" parse-escape-sequences="true" display-tooltip-when-elided="true" name="messageLabel" class="dynamic-message-label cursor-link" />
                </ui:VisualElement>
                <ui:VisualElement name="latestVideos" class="latest-videos-card">
                    <ui:Label tabindex="-1" text="Latest Videos" parse-escape-sequences="true" display-tooltip-when-elided="true" class="latest-videos-title" />
                    <ui:VisualElement name="latestVideos1Container" class="latest-videos-row cursor-link">
                        <ui:VisualElement name="_1Container" class="video-slot-container" />
                        <ui:VisualElement name="_2Container" class="video-slot-container" />
                    </ui:VisualElement>
                    <ui:VisualElement name="latestVideos2Container" class="latest-videos-row cursor-link">
                        <ui:VisualElement name="_3Container" class="video-slot-container" />
                        <ui:VisualElement name="_4Container" class="video-slot-container" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="myGames" class="my-games-container">
                    <ui:Label tabindex="-1" text="&lt;a href=&quot;https://cmonkey.co/dinkyguardians&quot;&gt;&lt;u&gt;Play Dinky Guardians!&lt;/u&gt;&lt;/a&gt;" parse-escape-sequences="true" display-tooltip-when-elided="true" class="my-games-label" />
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:Label tabindex="-1" text="0.01" parse-escape-sequences="true" display-tooltip-when-elided="true" name="versionLabel" class="version-tag-label" />
        <ui:VisualElement name="lectureList" class="lecture-list-container">
            <ui:Button text="Back to Main Menu" parse-escape-sequences="true" display-tooltip-when-elided="true" name="backToMainMenuButton" class="back-to-menu-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
