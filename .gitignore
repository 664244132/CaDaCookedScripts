# ====================================================================
# Unity GitIgnore Rule (Standard for Unity 6 & Multi-platform Projects)
# ====================================================================

# 1. Unity Temporary, Cache, and Generated Build Directories
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emoryCaptures/
**/[Rr]ecordings/

# 2. Standalone Game Builds & Output Folders
DEMO-*/
DEMO-KaDaCooked/
WindowsBuild/
WebGLBuild/
StandaloneWindows64/
*.apk
*.aab
*.app
*.unitypackage

# 3. Package Management (Ignore downloaded PackageCache, Keep manifests)
[Pp]ackage[Cc]ache/
**/[Pp]ackage[Cc]ache/
[Pp]ackages/
!/[Pp]ackages/manifest.json
!/[Pp]ackages/packages-lock.json

# 4. Autogenerated C# Solution and Project Files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.pdb.meta
*.csproj.meta
*.unityproj.meta
*.sln.meta
*.slnx.meta
sysinfo.txt
*.log
*.stackdump

# 5. Unity Asset Serialization Artifacts / Cache
ExportedObj/
.consulo/
.vsconfig
*.opendb
*.db

# 6. IDE, Code Editor & Agent Cache Directories
.vs/
.vscode/
.idea/
.gradle/
.agents/
.gemini/
.antigravity/
*.swp
*~

# 7. Plastic SCM / Unity Version Control Local Files
.plastic/
*.private
*.private.meta
^*.private
^*.private.meta

# 8. OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 9. Crashlytics & Analytics
crashlytics-build.properties
CrashReports/
