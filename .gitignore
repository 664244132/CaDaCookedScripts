# ====================================================================
# Unity GitIgnore Rule (Standard for Unity 6 & Multi-platform Projects)
# ====================================================================

# 1. Unity Temporary, Cache, and Build Directories (Root and Nested)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emoryCaptures/
**/[Rr]ecordings/

# 2. Package Management (Ignore downloaded PackageCache, Keep manifests)
[Pp]ackage[Cc]ache/
**/[Pp]ackage[Cc]ache/
[Pp]ackages/
!/[Pp]ackages/manifest.json
!/[Pp]ackages/packages-lock.json

# 3. Autogenerated C# Solution and Project Files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.pdb.meta
*.csproj.meta
*.unityproj.meta
*.sln.meta
*.slnx.meta
sysinfo.txt

# 4. Unity Asset Serialization Artifacts / Cache
ExportedObj/
.consulo/
.vsconfig
*.opendb
*.db

# 5. IDE and Editor Directories & Configs
.vs/
.vscode/
.idea/
.gradle/
*.swp
*~

# 6. Plastic SCM / Unity Version Control Local Files
*.private
*.private.meta
^*.private
^*.private.meta

# 7. OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 8. Crashlytics & Analytics
crashlytics-build.properties
