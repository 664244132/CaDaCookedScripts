# AI Agent Ignore File (.antigravityignore)
# This file specifies which files and directories AI agents should ignore when reading or searching the codebase.

# 1. Version Control and IDEs
.git/
.vs/
.vscode/
.idea/
*.suo
*.user
*.userprefs
*.db
*.opendb

# 2. Unity Temporary and Cache Directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Pp]ackage[Cc]ache/

# 3. Autogenerated C# Project & Solution Files
*.csproj
*.sln
*.slnx
*.tmp
*.pdb
sysinfo.txt

# 4. Unity Meta Files (contain only GUIDs, not useful for code understanding and clutters searches)
*.meta

# 5. Unity Asset Serialization Files (typically large YAML/binary, not readable as code)
*.unity
*.prefab
*.asset
*.mat
*.controller
*.anim
*.overrideController
*.physicMaterial
*.physicsMaterial2D
*.playable

